# Flask
FLASK_APP=
DEBUG=                     # MUST be false in production (leave blank/false)
COOKIE_SECURE=             # defaults true (Secure session cookies); set false ONLY for local plain-HTTP dev
SECRET_KEY=                # signs Flask sessions
INVITE_JWT_SECRET=         # signs invite tokens; keep DISTINCT from SECRET_KEY (falls back to it if unset)
PASSWORD_RESET_JWT_SECRET= # signs password reset tokens; keep DISTINCT from SECRET_KEY (falls back to it if unset)
BASE_URL=                  # legacy alias for PUBLIC_BASE_URL (used if PUBLIC_BASE_URL is unset)
PUBLIC_BASE_URL=           # public origin for links in outbound email, e.g. https://canask.example.ca (no trailing slash)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=
# GUNICORN_WORKERS=3       # (prod) web worker count; base compose defaults to 3
# CONTENT_SECURITY_POLICY= # (optional) override the default CSP built in data_viz/config.py

# DB
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=

# Redis/Celery:
# In production set REDIS_PASSWORD and put it in the Redis URLs below (and RATELIMIT_STORAGE_URI if
# overridden), e.g. redis://:THE_PASSWORD@redis:6379/0  (the prod compose starts Redis with --requirepass)
REDIS_PASSWORD=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AWS/SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SES_SENDER_EMAIL=
# Optional: Reply-To header on outbound mail (e.g. a real inbox when SES_SENDER_EMAIL is a no-reply address)
SES_REPLY_TO_EMAIL=
# Optional: recipient for feedback-form emails (defaults in data_viz/config.py)
# FEEDBACK_EMAIL=

# Invite links: how long an emailed invite stays valid (default 72h = 3 days)
# INVITE_EXPIRY_HOURS=72

# Password reset links: how long an emailed reset link stays valid (default 60 minutes)
# PASSWORD_RESET_EXPIRY_MINUTES=60

# Recaptcha (v3 invisible + score) — protects the login and feedback POSTs. Site key + secret are a
# matched pair from the SAME v3 registration (https://www.google.com/recaptcha/admin); site key is
# public (rendered in the page), secret is server-side. RECAPTCHA_ENABLED=false bypasses reCAPTCHA
# entirely (use in dev — v2 keys can't verify against v3); MIN_SCORE is the reject threshold (0-1).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# RECAPTCHA_ENABLED=true
# RECAPTCHA_MIN_SCORE=0.5

# Rate limiting (all optional; safe defaults live in data_viz/config.py)
# RATELIMIT_STORAGE_URI=redis://redis:6379/1
# RATELIMIT_ENABLED=true
# RATELIMIT_DEFAULT=200 per minute
# RATELIMIT_CLIENT_IP_HEADER=CF-Connecting-IP
# TRUSTED_PROXY_COUNT=2
# RATELIMIT_FEEDBACK=5 per hour
# RATELIMIT_FEEDBACK_GLOBAL=100 per day
# RATELIMIT_API=60 per minute
# RATELIMIT_LOGIN=10 per minute
# RATELIMIT_PASSWORD_RESET=5 per hour
# RATELIMIT_PASSWORD_RESET_GLOBAL=100 per day

# Lockout for the shared site admin key guarding site-admin membership changes (optional; defaults in config.py)
# SITE_ADMIN_KEY_LOCKOUT_THRESHOLD=5
# SITE_ADMIN_KEY_LOCKOUT_WINDOW_MINUTES=15
# SITE_ADMIN_KEY_LOCKOUT_GLOBAL_THRESHOLD=20