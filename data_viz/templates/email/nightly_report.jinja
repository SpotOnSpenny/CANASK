<div style="font-family:Arial,sans-serif;font-size:14px;color:#222">
  <h2 style="margin:0 0 4px">CANASK nightly data report</h2>
  <p style="margin:0 0 16px;color:#666">{{ data.window_start|mt }} – {{ data.window_end|mt }} (Mountain)</p>

  <h3>What ran</h3>
  {% if data.ran %}
  <table cellpadding="4" style="border-collapse:collapse">
    {% for r in data.ran %}<tr><td>{{ r.source }}</td><td>{{ r.trigger }}</td><td><b>{{ r.status }}</b></td>
      <td>{{ (r.duration.total_seconds() // 60)|int ~ " min" if r.duration else "" }}</td></tr>{% endfor %}
  </table>
  {% else %}<p>Nothing ran in this window.</p>{% endif %}

  <h3>Updated</h3>
  {% for u in data.updated %}<p>{{ u.source }}: {{ u["from"] or "—" }} → <b>{{ u.to }}</b> ({{ u.trigger }})</p>
  {% else %}<p>No sources updated.</p>{% endfor %}

  <h3>Issues</h3>
  {% for i in data.issues %}<p><b>{{ i.source }}</b> — {{ i.status }}
    {% for c in i.checks %}<br>&bull; {{ c.message }}{% endfor %}
    {% for line in i.error %}<br><code>{{ line }}</code>{% endfor %}</p>
  {% else %}<p>No issues.</p>{% endfor %}

  {% if data.new_data %}<h3>New data available</h3>
  {% for n in data.new_data %}<p><b>{{ n.source }}</b>{% for x in n.notices %}<br>&bull; {{ x.message }}{% endfor %}</p>{% endfor %}{% endif %}

  <h3>Status</h3>
  <table cellpadding="4" style="border-collapse:collapse">
    {% for s in data.status %}<tr><td>{{ s.source }}</td><td>
      {% if not s.onboarded %}not onboarded{% else %}
      {{ "scheduled" if s.schedule_enabled else ("PAUSED: " ~ s.paused_reason if s.paused_reason else "schedule off") }}
      · {{ "auto-publish" if s.auto_publish else "auto-publish off" }}
      {% if s.held %} · <b>{{ s.held }} held</b>{% endif %}{% if s.running %} · still running{% endif %}
      {% if s.stale %} · <b>stale {{ s.stale_days }}d</b>{% endif %}{% endif %}</td></tr>{% endfor %}
  </table>
  <p><a href="{{ page_url }}">Open Data Updates</a></p>
</div>
