<!doctype html>
<html lang="en" class="overflow-y-hidden">

<head>
    <title>CANASK{% if nav_title %} | {{ nav_title }}{% endif %}</title>

    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="csrf-token" content="{{ csrf_token() }}" />
    {% if config.RECAPTCHA_ENABLED and config.RECAPTCHA_SITE_KEY %}
    <meta name="recaptcha-site-key" content="{{ config.RECAPTCHA_SITE_KEY }}" />
    {% endif %}

    <!-- Theme bootstrap: set light/dark before paint to avoid a flash -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('canask-theme');
                var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) { /* storage unavailable */ }
        })();
    </script>

    <!-- Inter (UI + tabular data figures) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Google reCAPTCHA v3 (invisible). Loaded only when enabled + a site key is set; dev bypasses
         it via RECAPTCHA_ENABLED=false. main.js reads the site key from the meta above. -->
    {% if config.RECAPTCHA_ENABLED and config.RECAPTCHA_SITE_KEY %}
    <script src="https://www.google.com/recaptcha/api.js?render={{ config.RECAPTCHA_SITE_KEY }}"></script>
    {% endif %}

    <!-- Bootstrap CSS v5.2.1 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous" />

    <!-- Bootstrap JavaScript Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"
        integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+"
        crossorigin="anonymous"></script>
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {% assets "css_all" %}
    <link rel="stylesheet" href="{{ ASSET_URL }}">
    {% endassets %}

</head>

<!-- Google analytics tag goes after the head for analytics -->
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-6XJ33EGST3"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-6XJ33EGST3');
</script>

<body class="overflow-x-hidden overflow-y-hidden">
    <button id="canask-theme-toggle" type="button" class="canask-theme-toggle" aria-label="Toggle dark mode"
        aria-pressed="false" title="Toggle light / dark theme">
        <i class="bi bi-moon-stars theme-icon-light" aria-hidden="true"></i>
        <i class="bi bi-sun theme-icon-dark" aria-hidden="true"></i>
    </button>
    <div id="flashed-messages-container">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="position-fixed top-0 start-50 translate-middle-x pt-3" style="z-index: 1050; width: 50%;">
                    {% for category, message in messages %}
                        <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}
    </div>
    <div class="modal fade" id="adjustPermissionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="modal-container"></div>
            </div>
        </div>
    </div>
    <div class="bg-light position-absolute top-0 start-0 w-100 z-n1"></div>
    <div id="partial-inclusions" class="fade-me-in fade-me-out-left">
        {% if include_partials == "index" %}
        {% include 'index.jinja' %}
        {% elif include_partials == "login" %}
        {% include 'v1/login.jinja' %}
        {% elif include_partials == "accept invite" %}
        {% include 'v1/accept_invite.jinja' %}
        {% elif include_partials == "429" %}
        {% include '429.jinja' %}
        {% endif %}
    </div>
    <div>
        {% block body_content %}
        {% endblock %}
    </div>
    {% assets "js_all" %}
    <script type="text/javascript" src="{{ ASSET_URL }}"></script>
    {% endassets %}
</body>

<script>
    document.body.addEventListener('close.bs.alert', function(event) {
        if (event.target.closest('#flashed-messages-container')) {
            event.preventDefault();
            event.target.classList.add('fade-out');
            setTimeout(() => event.target.remove(), 300);
        }
    });

    // Light / dark theme toggle (button lives in the persistent base layout)
    (function () {
        function reflect(theme) {
            var btn = document.getElementById('canask-theme-toggle');
            if (btn) { btn.setAttribute('aria-pressed', String(theme === 'dark')); }
        }
        function setTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-bs-theme', theme);
            try { localStorage.setItem('canask-theme', theme); } catch (e) {}
            reflect(theme);
            // Re-theme any Plotly charts on the page (helper lives in the JS bundle)
            if (typeof window.canaskRedrawCharts === 'function') { window.canaskRedrawCharts(); }
        }
        reflect(document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
        document.addEventListener('click', function (event) {
            var btn = event.target.closest && event.target.closest('#canask-theme-toggle');
            if (!btn) return;
            var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
            setTheme(current === 'dark' ? 'light' : 'dark');
        });
    })();
</script>
</html>