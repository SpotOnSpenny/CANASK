<div class="modal-header">
    <h5 class="modal-title">Create a Group</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form id="create-group-form"
      hx-post="/v1/create-group"
      hx-target="#content-div"
      hx-swap="innerHTML swap:1s settle:1s"
      hx-disabled-elt="find button[type='submit']"
      hx-on::after-request="bootstrap.Modal.getInstance(document.getElementById('adjustPermissionsModal')).hide()">
    <div class="modal-body">
        <p class="form-intro">Create a new group. You can choose which data sources it can access
            afterwards from the Group Management page.</p>
        <div id="form-alerts"></div>

        <div class="mb-3">
            <label for="group-name" class="form-label fw-semibold">Group Name</label>
            <input type="text"
                   id="group-name"
                   name="name"
                   class="form-control"
                   placeholder="Enter a unique group name"
                   required>
        </div>

        <div class="mb-3">
            <label for="group-description" class="form-label fw-semibold">Description <span class="text-muted fw-normal">(optional)</span></label>
            <textarea id="group-description"
                      name="description"
                      class="form-control"
                      rows="2"
                      placeholder="What is this group for?"></textarea>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Group</button>
    </div>
</form>

<script>
    (function() {
        const form = document.getElementById('create-group-form');
        // Block submit if the name is blank
        form.addEventListener('htmx:configRequest', function(event) {
            const name = document.getElementById('group-name').value.trim();
            if (!name) {
                event.preventDefault();
                document.getElementById('form-alerts').innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        Please enter a group name.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
            }
        });
    })();
</script>
