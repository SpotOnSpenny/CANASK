{# One stored feedback submission as a collapsible card (same header/collapse pattern as the Data
   Ownership source cards). Rendered collapsed by the page list and expanded by every mutation route,
   which swaps it back in with outerHTML on #feedback-<id>. #}
<div id="feedback-{{ s.id }}" class="card shadow-sm mb-3 feedback-card">
    <div class="card-header d-flex justify-content-between align-items-center gap-2 {{ '' if expanded else 'collapsed' }}"
         role="button" data-bs-toggle="collapse" data-bs-target="#feedback-body-{{ s.id }}"
         aria-expanded="{{ 'true' if expanded else 'false' }}" aria-controls="feedback-body-{{ s.id }}"
         style="cursor: pointer;">
        <h6 class="mb-0 text-truncate">
            <i class="bi bi-chevron-down me-2 small" aria-hidden="true"></i>#{{ s.id }} &middot; {{ s.name or "Anonymous" }}
            <span class="text-body-secondary small fw-normal ms-2">
                {{ s.created_at.strftime('%Y-%m-%d %H:%M') }} UTC{% if s.page %} &middot; {{ s.page }}{% endif %}
            </span>
        </h6>
        <span class="d-flex gap-1 flex-shrink-0">
            {% if s.is_addressed %}
            <span class="badge bg-success">Addressed</span>
            {% else %}
            <span class="badge bg-warning text-dark">Open</span>
            {% endif %}
            {% if s.email_status == "failed" %}<span class="badge bg-danger">Email failed</span>
            {% elif s.email_status == "unknown" %}<span class="badge bg-secondary">Email status unknown</span>{% endif %}
            {% if s.notes %}<span class="badge bg-secondary">{{ s.notes|length }} note{{ '' if s.notes|length == 1 else 's' }}</span>{% endif %}
        </span>
    </div>
    <div id="feedback-body-{{ s.id }}" class="card-body collapse {{ 'show' if expanded }}">
        <p class="feedback-message mb-3">{{ s.body }}</p>
        <dl class="row small mb-3">
            <dt class="col-sm-3 col-lg-2">Reach them at</dt>
            <dd class="col-sm-9 col-lg-10">{% if s.email %}<a href="mailto:{{ s.email }}">{{ s.email }}</a>{% else %}Not provided{% endif %}</dd>
            <dt class="col-sm-3 col-lg-2">Page</dt>
            <dd class="col-sm-9 col-lg-10">{% if s.page %}<a href="{{ s.page }}">{{ s.page }}</a>{% else %}Unknown{% endif %}</dd>
            {% if s.user %}
            <dt class="col-sm-3 col-lg-2">Signed in as</dt>
            <dd class="col-sm-9 col-lg-10">{{ s.user.username }}</dd>
            {% endif %}
            <dt class="col-sm-3 col-lg-2">Notification email</dt>
            <dd class="col-sm-9 col-lg-10">
                {% if s.email_status == "sent" %}Sent
                {% elif s.email_status == "failed" %}<span class="text-danger">Failed</span> &ndash; {{ s.email_error }}
                {% else %}Unknown &ndash; the status was not recorded (the send may have succeeded; see the web container log)
                {% endif %}
            </dd>
            {% if s.is_addressed %}
            <dt class="col-sm-3 col-lg-2">Addressed</dt>
            <dd class="col-sm-9 col-lg-10">
                {{ s.addressed_at.strftime('%Y-%m-%d %H:%M') }} UTC{% if s.addressed_by_user %} by {{ s.addressed_by_user.username }}{% endif %}
            </dd>
            {% endif %}
        </dl>
        <div class="d-flex flex-wrap gap-2 mb-3">
            {% if s.is_addressed %}
            <button type="button" class="btn btn-sm btn-outline-secondary"
                hx-post="/v1/admin/feedback/{{ s.id }}/reopen"
                hx-target="#feedback-{{ s.id }}" hx-swap="outerHTML" hx-disabled-elt="this">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reopen
            </button>
            {% else %}
            <button type="button" class="btn btn-sm btn-success"
                hx-post="/v1/admin/feedback/{{ s.id }}/address"
                hx-target="#feedback-{{ s.id }}" hx-swap="outerHTML" hx-disabled-elt="this">
                <i class="bi bi-check2 me-1"></i>Mark addressed
            </button>
            {% endif %}
            <button type="button" class="btn btn-sm btn-outline-danger"
                hx-post="/v1/admin/feedback/{{ s.id }}/delete"
                hx-target="#feedback-{{ s.id }}" hx-swap="outerHTML"
                hx-confirm="Delete feedback #{{ s.id }} from {{ s.name or 'Anonymous' }}? Its notes are deleted with it. This cannot be undone."
                data-confirm-title="Delete Feedback" data-confirm-button="Delete" data-confirm-class="btn-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
        </div>
        <h6 class="small text-uppercase text-body-secondary mb-1">Notes</h6>
        {% for note in s.notes %}
        <div class="d-flex justify-content-between align-items-start gap-2 border-top py-2">
            <div class="flex-grow-1">
                <div class="small text-body-secondary">{{ note.author.username }} &middot; {{ note.created_at.strftime('%Y-%m-%d %H:%M') }} UTC</div>
                <div class="feedback-message">{{ note.text }}</div>
            </div>
            <button type="button" class="btn btn-sm btn-link text-danger p-0 flex-shrink-0"
                hx-post="/v1/admin/feedback/{{ s.id }}/notes/{{ note.id }}/delete"
                hx-target="#feedback-{{ s.id }}" hx-swap="outerHTML"
                hx-confirm="Delete this note by {{ note.author.username }}?"
                data-confirm-title="Delete Note" data-confirm-button="Delete" data-confirm-class="btn-danger"
                aria-label="Delete note">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </div>
        {% else %}
        <p class="small text-body-secondary mb-2">No notes yet.</p>
        {% endfor %}
        <form class="mt-2" hx-post="/v1/admin/feedback/{{ s.id }}/notes"
              hx-target="#feedback-{{ s.id }}" hx-swap="outerHTML"
              hx-disabled-elt="find button[type='submit']">
            <label for="feedback-note-{{ s.id }}" class="visually-hidden">Add a note</label>
            <textarea id="feedback-note-{{ s.id }}" class="form-control form-control-sm" name="text"
                      rows="2" maxlength="2000" required placeholder="Add a note (who followed up, what changed, ...)"></textarea>
            <button type="submit" class="btn btn-sm btn-outline-primary mt-2">
                <i class="bi bi-plus-lg me-1"></i>Add note
            </button>
        </form>
    </div>
</div>
