<div class="modal-header">
    <h5 class="modal-title">Renew Site Admin Invite — {{ invite.email }}</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
{# Field-level failures re-render this partial into the open modal (HX-Retarget); the hide
   below only fires on responses without that header, so the modal survives a typo. #}
<form hx-post="/v1/invites/{{ invite.id }}/renew"
      hx-target="#invite-row-{{ invite.id }}"
      hx-swap="outerHTML"
      hx-on::after-request="if (!event.detail.xhr.getResponseHeader('HX-Retarget')) bootstrap.Modal.getInstance(document.getElementById('adjustPermissionsModal')).hide()">
    <div class="modal-body">
        {% if error %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}
        <p>Renew the site admin invite for <strong>{{ invite.email }}</strong>.</p>
        <p class="form-text">This issues a fresh sign-up link that will make the recipient a site
            admin, so it requires the same confirmation as granting site admin access directly.</p>

        <div class="mb-3">
            <label class="form-label" for="renewal-own-password">Your account password</label>
            <input class="form-control" type="password" name="own_password"
                   id="renewal-own-password" autocomplete="current-password" required>
        </div>
        <div class="mb-3">
            <label class="form-label" for="renewal-shared-password">Site admin key</label>
            <input class="form-control" type="password" name="site_admin_key"
                   id="renewal-shared-password" autocomplete="off" required>
            <div class="form-text">The shared site admin key guards every site admin membership change.</div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Renew Invite</button>
    </div>
</form>
