<div class="modal-header">
    <h5 class="modal-title">Data Sources — {{ group.name }}</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form hx-post="/v1/groups/{{ group.id }}/data-sources"
      hx-target="#group-row-{{ group.id }}"
      hx-swap="outerHTML"
      hx-on::after-request="bootstrap.Modal.getInstance(document.getElementById('adjustPermissionsModal')).hide()">
    <div class="modal-body">
        {% if not source_rows %}
            <p class="text-muted mb-0">There are no data sources to assign yet. Seed the data source
                catalog first.</p>
        {% else %}
            <p class="form-intro">Choose which data sources <strong>{{ group.name }}</strong> can access.</p>
            {% for item in source_rows %}
            <div class="mb-2 p-2 border rounded">
                <div class="form-check mb-0">
                    <input class="form-check-input source-check"
                           type="checkbox"
                           name="source_ids"
                           value="{{ item.source.id }}"
                           id="source_{{ item.source.id }}"
                           {% if item.checked %}checked{% endif %}>
                    <label class="form-check-label fw-semibold" for="source_{{ item.source.id }}">
                        {{ item.source.name }}
                    </label>
                    {% if item.source.link %}
                        <a href="{{ item.source.link }}" target="_blank" rel="noopener"
                           class="ms-2 small text-decoration-none">source ↗</a>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" {% if not source_rows %}disabled{% endif %}>Save Changes</button>
    </div>
</form>

<script>
    (function() {
        // Initial state so we can block a no-op submit
        const initial = {};
        document.querySelectorAll('.source-check').forEach(cb => {
            initial[cb.value] = cb.checked;
        });

        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('htmx:configRequest', function(event) {
                let changed = false;
                document.querySelectorAll('.source-check').forEach(cb => {
                    if (cb.checked !== initial[cb.value]) changed = true;
                });
                if (!changed) {
                    event.preventDefault();
                    const modalBody = document.querySelector('.modal-body');
                    if (!modalBody.querySelector('.no-change-alert')) {
                        const alert = document.createElement('div');
                        alert.className = 'alert alert-warning alert-dismissible fade show no-change-alert';
                        alert.innerHTML = `No changes were made. <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
                        modalBody.insertBefore(alert, modalBody.firstChild);
                    }
                }
            });
        }
    })();
</script>
