<tr id="invite-row-{{ invite.id }}">
    <td>{{ invite.email }}</td>
    <td>
        {% if invite.site_admin_invite %}
            <span class="badge bg-primary">Site Admin</span>
        {% else %}
            {% for ig in invite.invite_groups %}
                {% if managed_group_ids is none or ig.group_id in managed_group_ids %}
                    <span class="badge bg-secondary">{{ ig.group.name }} — {{ ig.role }}</span>
                {% endif %}
            {% endfor %}
        {% endif %}
    </td>
    <td>{{ invite.sent_by_user.username }}</td>
    <td>{{ invite.sent_at.strftime('%Y-%m-%d') }}</td>
    <td>{{ invite.expires_at.strftime('%Y-%m-%d') }}</td>
    <td>
        {% if invite.status == "pending" %}
            <span class="badge bg-warning text-dark">Pending</span>
        {% elif invite.status == "accepted" %}
            <span class="badge bg-success">Accepted</span>
        {% elif invite.status == "expired" %}
            <span class="badge bg-secondary">Expired</span>
        {% elif invite.status == "revoked" %}
            <span class="badge bg-danger">Revoked</span>
        {% endif %}
    </td>
    <td>
    {% if invite.status == "pending" %}
        {# Whether revoking removes the WHOLE invite (the actor manages every group on it --
           site admins always do) or only strips their managed groups; matches revoke_invite's
           branches and drives the revoke label + confirm text below. #}
        {% set all_groups_managed = managed_group_ids is none
           or invite.invite_groups | rejectattr("group_id", "in", managed_group_ids) | list | length == 0 %}
        <div class="dropdown">
            <button class="btn btn-sm invite-action-btn dropdown-toggle" 
                    type="button" 
                    data-bs-toggle="dropdown"
                    data-bs-boundary="viewport">
            </button>
            <ul class="dropdown-menu">
                <li>
                    {% set can_adjust = namespace(value=false) %}
                    {% for ig in invite.invite_groups %}
                        {% if managed_group_ids is none or ig.group_id in managed_group_ids %}
                            {% if not invite.site_admin_invite %}
                                {% set user_role = 'Site Admin' if current_user.site_admin else groups_with_required_role[ig.group_id] %}
                                {% if role_hierarchy[user_role] > role_hierarchy[ig.role] %}
                                    {% set can_adjust.value = true %}
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}

                    {# Site admins may adjust site-admin invites too (demote via the
                       modal's checkbox); everyone else still only sees it for group
                       invites they out-rank. #}
                    {% if can_adjust.value or current_user.site_admin %}
                    <li>
                        <button class="dropdown-item"
                            hx-get="/v1/invites/{{ invite.id }}/adjust-permissions"
                            hx-target="#modal-container"
                            hx-swap="innerHTML"
                            hx-on::after-request="new bootstrap.Modal(document.getElementById('adjustPermissionsModal')).show()">
                            Adjust Permissions
                        </button>
                    </li>
                    {% endif %}
                </li>
                <li>
                    <button class="dropdown-item"
                        hx-post="/v1/invites/{{ invite.id }}/resend"
                        hx-target="#invite-row-{{ invite.id }}"
                        hx-swap="outerHTML">
                        Resend
                    </button>
                </li>
                {% if not invite.site_admin_invite or current_user.site_admin %}
                <li>
                    <button class="dropdown-item text-danger"
                        hx-post="/v1/invites/{{ invite.id }}/revoke"
                        hx-target="#invite-row-{{ invite.id }}"
                        hx-swap="outerHTML"
                        hx-confirm="{{ 'Revoke this invite to ' ~ invite.email ~ '? Their sign-up link will stop working.' if all_groups_managed else 'Remove this group from the invite for ' ~ invite.email ~ '?' }}"
                        data-confirm-title="{{ 'Revoke Invite' if all_groups_managed else 'Revoke Group Permission' }}"
                        data-confirm-button="{{ 'Revoke' if all_groups_managed else 'Remove' }}"
                        data-confirm-class="btn-danger">
                        {{ "Revoke Invite" if all_groups_managed else "Revoke Group Permission" }}
                    </button>
                </li>
                {% endif %}
            </ul>
        </div>
        {% elif invite.status == "expired" %}
            <div class="dropdown">
                <button class="btn btn-sm invite-action-btn dropdown-toggle" 
                        type="button" 
                        data-bs-toggle="dropdown"
                        data-bs-boundary="viewport">
                </button>
                <ul class="dropdown-menu">
                    <li>
                        {% if invite.site_admin_invite %}
                        {# Renewing a site-admin invite re-mints an admin credential, so it goes
                           through the credentials modal (own password + site admin key). #}
                        <button class="dropdown-item"
                            hx-get="/v1/invites/{{ invite.id }}/renew"
                            hx-target="#modal-container"
                            hx-swap="innerHTML"
                            hx-on::after-request="new bootstrap.Modal(document.getElementById('adjustPermissionsModal')).show()">
                            Renew
                        </button>
                        {% else %}
                        <button class="dropdown-item"
                            hx-post="/v1/invites/{{ invite.id }}/renew"
                            hx-target="#invite-row-{{ invite.id }}"
                            hx-swap="outerHTML">
                            Renew
                        </button>
                        {% endif %}
                    </li>
                </ul>
            </div>
        {% else %}
            <span class="text-muted">—</span>
        {% endif %}
    </td>
</tr>