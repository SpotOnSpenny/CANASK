<div class="modal-header">
    <h5 class="modal-title">Adjust Permissions — {{ invite.email }}</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form hx-post="/v1/invites/{{ invite.id }}/adjust-permissions"
      hx-target="#invite-row-{{ invite.id }}"
      hx-swap="outerHTML"
      {# Only hide on a successful non-retargeted response: a retarget re-renders the form in
         place, and a 5xx/network failure must leave the modal (and the user's edits) intact. #}
      hx-on::after-request="if (event.detail.successful && !event.detail.xhr.getResponseHeader('HX-Retarget')) bootstrap.Modal.getInstance(document.getElementById('adjustPermissionsModal')).hide()">
    <div class="modal-body">
        {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
        {% endif %}
        {% if current_user.site_admin %}
        <div class="form-check form-switch mb-3">
            {# attempted_admin: a failed elevation re-render -- keep the switch checked and the
               credential fields visible so the admin can just retry. data-attempted tells the
               change-detection JS the server-side state is still "not admin". #}
            <input class="form-check-input" type="checkbox" id="site_admin_check"
                   name="site_admin_invite" value="true"
                   {% if attempted_admin %}data-attempted="true"{% endif %}
                   {% if invite.site_admin_invite or attempted_admin %}checked{% endif %}>
            <label class="form-check-label fw-semibold" for="site_admin_check">
                Site Admin invite
            </label>
        </div>
        {% if not invite.site_admin_invite %}
        {# Elevation spends the shared key; demote (unchecking on an already-admin
           invite) needs no credentials, so the block only exists on plain invites. #}
        {# The inputs are disabled while the block is hidden: a plain `required` on a hidden
           field would block non-elevation saves ("not focusable"), and enabled-but-hidden
           fields would submit empty credentials and burn counted lockout failures. The JS
           enables them (required then applies) whenever the switch reveals the block. #}
        <div id="adjust-admin-credentials" class="{% if not attempted_admin %}d-none {% endif %}border rounded p-2 mb-3">
            <p class="small text-muted mb-2">
                Upgrading to a site admin invite requires your password and the site admin key.
            </p>
            <div class="mb-2">
                <label class="form-label" for="adjust-own-password">Your password</label>
                <input type="password" class="form-control" id="adjust-own-password"
                       name="own_password" autocomplete="current-password"
                       required {% if not attempted_admin %}disabled{% endif %}>
            </div>
            <div class="mb-2">
                <label class="form-label" for="adjust-site-admin-key">Site admin key</label>
                <input type="password" class="form-control" id="adjust-site-admin-key"
                       name="site_admin_key" autocomplete="off"
                       required {% if not attempted_admin %}disabled{% endif %}>
            </div>
        </div>
        {% endif %}
        {% endif %}
        {% for item in adjustable_groups %}
        <div class="mb-3 p-2 border rounded group-assignment-row"
             id="group_row_{{ item.invite_group.group_id }}">
            <div class="d-flex align-items-center gap-3">
                <div class="form-check mb-0">
                    <input class="form-check-input group-check"
                           type="checkbox"
                           id="include_{{ item.invite_group.group_id }}"
                           {% if item.invite_group.role %}checked{% endif %}>
                </div>
                <label class="form-label mb-0 fw-semibold flex-grow-1">
                    {{ item.invite_group.group.name }}
                </label>
            <select class="form-select form-select-sm w-50" 
                    name="role_{{ item.invite_group.group_id }}"
                    id="select_{{ item.invite_group.group_id }}"
                    {% if not item.invite_group.id and not item.invite_group.role %}disabled{% endif %}>
                    {% for role in item.assignable_roles %}
                        <option value="{{ role }}"
                            {% if role == item.invite_group.role %}selected{% endif %}>
                            {{ role }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>
        {% endfor %}
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

<script>
    (function() {
        const siteAdminCheck = document.getElementById('site_admin_check');

        // Initial state tracking 
        const initialState = {};
        document.querySelectorAll('.group-check').forEach(cb => {
            const groupId = cb.id.replace('include_', '');
            const select = document.getElementById(`select_${groupId}`);
            initialState[groupId] = {
                checked: cb.checked,
                role: select ? select.value : null
            };
        });
        if (siteAdminCheck) {
            // After a failed elevation (data-attempted) the box renders checked for the retry,
            // but the server-side state is still "not admin" -- track that as the baseline so
            // the retry submit registers as a change.
            initialState['site_admin'] = siteAdminCheck.checked && !siteAdminCheck.dataset.attempted;
        }

        // Site admin state helpers
        function setSiteAdminState(checked) {
            const creds = document.getElementById('adjust-admin-credentials');
            if (creds) creds.classList.toggle('d-none', !checked);
            // Credential inputs are required-but-disabled while hidden (see the template
            // comment); enabling them here is what arms the required validation.
            ['adjust-own-password', 'adjust-site-admin-key'].forEach(id => {
                const input = document.getElementById(id);
                if (input) input.disabled = !checked;
            });
            document.querySelectorAll('.group-assignment-row').forEach(row => {
                row.style.opacity = checked ? '0.4' : '1';
                row.style.pointerEvents = checked ? 'none' : 'auto';
            });
            document.querySelectorAll('.group-check').forEach(cb => {
                cb.disabled = checked;
                if (checked) {
                    cb.checked = false;
                    cb.closest('.group-assignment-row').querySelector('select').disabled = true;
                }
            });
        }

        // Group checkbox listeners. (The switch is deliberately NOT disabled while groups are
        // checked -- checking it clears the group rows via setSiteAdminState, and a reverse
        // lock would leave the elevation UI unreachable on any invite with a group row.)
        document.querySelectorAll('.group-check').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const select = this.closest('.group-assignment-row').querySelector('select');
                select.disabled = !this.checked;
            });
        });

        // Site admin checkbox listener
        if (siteAdminCheck) {
            siteAdminCheck.addEventListener('change', function() {
                setSiteAdminState(this.checked);
            });
            if (siteAdminCheck.checked) {
                setSiteAdminState(true);
            }
        }

        // HTMX submit validation 
        document.querySelector('form').addEventListener('htmx:configRequest', function(event) {
            let changed = false;

            if (siteAdminCheck && siteAdminCheck.checked !== initialState['site_admin']) {
                changed = true;
            }

            document.querySelectorAll('.group-check').forEach(cb => {
                const groupId = cb.id.replace('include_', '');
                const select = document.getElementById(`select_${groupId}`);
                const initial = initialState[groupId];
                if (cb.checked !== initial.checked) changed = true;
                if (cb.checked && select && select.value !== initial.role) changed = true;
            });

            if (!changed) {
                event.preventDefault();
                const modalBody = document.querySelector('.modal-body');
                if (!modalBody.querySelector('.no-change-alert')) {
                    const alert = document.createElement('div');
                    alert.className = 'alert alert-warning alert-dismissible fade show no-change-alert';
                    alert.innerHTML = `No permission changes were made. <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
                    modalBody.insertBefore(alert, modalBody.firstChild);
                }
            }
        });
    })();
</script>