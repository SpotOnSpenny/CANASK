<div class="modal-header">
    <h5 class="modal-title">Starting charts — {{ group.name }}</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form hx-post="/v1/groups/{{ group.id }}/landing"
      hx-target="#group-row-{{ group.id }}"
      hx-swap="outerHTML"
      hx-on::after-request="bootstrap.Modal.getInstance(document.getElementById('adjustPermissionsModal')).hide()">
    <div class="modal-body">
        {% if not scopes %}
            <p class="text-muted mb-0">Nothing to choose yet. <strong>{{ group.name }}</strong>
                needs access to at least two charts on the same page before there is a choice
                to make.</p>
        {% else %}
            <p class="form-intro">Pick the chart each page opens on for members of
                <strong>{{ group.name }}</strong>. Nobody outside the group is affected. You can
                choose any Public chart, any chart shared with this group, or one of the group's
                own. A chart marked <em>Data Owners only</em> hasn't been shared with the rest of
                the group yet, so those members will see the site default instead.</p>
            {% for scope in scopes %}
            <div class="mb-2 p-2 border rounded">
                <label class="form-label fw-semibold mb-1" for="landing_{{ scope.province }}">{{ scope.label }}</label>
                <select class="form-select form-select-sm" id="landing_{{ scope.province }}"
                        name="{{ field_prefix }}{{ scope.province }}">
                    <option value=""{% if not scope.current %} selected{% endif %}>Site default</option>
                    {% if scope.stale %}
                    {# Kept selected so saving the form unchanged does not silently drop it. Not
                       named: whoever opens this may no longer be allowed to see that visual. #}
                    <option value="{{ scope.current.id }}" selected>Earlier pick (no longer available)</option>
                    {% endif %}
                    {% for source_name, visuals in scope.by_source %}
                    <optgroup label="{{ source_name }}">
                        {% for v in visuals %}
                        <option value="{{ v.id }}"{% if scope.current and scope.current.id == v.id %} selected{% endif %}>{{ v | visual_label }}{% if v.id in scope.owners_only %} (Data Owners only){% endif %}</option>
                        {% endfor %}
                    </optgroup>
                    {% endfor %}
                </select>
                {% if scope.stale %}
                    <div class="form-text text-warning-emphasis mb-0">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        The group can't see this chart any more, so its members get the site
                        default until you pick another.</div>
                {% endif %}
            </div>
            {% endfor %}
        {% endif %}
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" {% if not scopes %}disabled{% endif %}>Save Changes</button>
    </div>
</form>
