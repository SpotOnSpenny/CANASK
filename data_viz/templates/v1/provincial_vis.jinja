<div class="container h-100 mobile-height-adjust py-2">
    <!-- This is the top row of the page -->
    <div class="row justify-content-center align-items-center py-2 mb-2 g-2 menu-row">
        <!-- This is the navigation bar for the different categories of visualizations -->
        <div class="col-md-8 mobile-height h-100">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center h-100">
                    <nav class="vis-breadcrumb" id="vis-breadcrumb" aria-label="Breadcrumb">
                        <span class="crumb crumb-current">{{ province.replace("-", " ").title() }}</span>
                    </nav>
                    <nav class="nav nav-pills flex-row justify-content-center" id="vis-selection-menu">
                        <div id="nav-spinner" class="spinner-border" role="status"></div>
                    </nav>
                </div>
            </div>
        </div>
        <!-- P.A.S.S. Score — a province-level summary score, in development -->
        <div class="col-md-4 h-100">
            <div class="card h-100 pass-card pass-card-soon">
                <div class="card-body h-100 d-flex flex-column justify-content-center text-center">
                    <div class="pass-soon-head">
                        <h5 class="pass-title card-title mb-0">P.A.S.S. Score</h5>
                        <span class="badge-soon">Coming soon</span>
                    </div>
                    <p class="pass-soon-text">A province-level summary score is in development.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- This is the main content area where the visualizations will be rendered -->
    <div class="row data-row pb-2">
        <div class="col-md h-100">
            <div class="card h-100">
                <div class="card-body text-center h-100 d-flex align-items-center justify-content-center" id="viz-card">
                    <!-- Overlayed controls -->
                    <div class="position-absolute top-0 start-0 m-1 z-3" style="">
                        <div id="data-type-toggle" class="d-flex btn-group mb-2 align-items-start" role="group" aria-label="Basic radio toggle button group">
                            <!-- Data type toggles will be dynamically generated here -->
                        </div>
                        <!-- Config-driven treemap stratifier dropdowns + time control are generated here -->
                        <div id="vis-stratifiers" class="d-flex flex-column gap-1 mb-2 treemap-controls"></div>
                        <div class="d-flex flex-column gap-2 align-items-start">
                            <button type="button" class="btn btn-secondary d-none" id="back-button"
                                onclick="resetVisual()" title="Back to Visualizations">
                                <i class="bi bi-arrow-left"></i>
                            </button>
                            <button type="button" class="btn btn-secondary d-none" id="reset-button"
                                onclick="resetVisual()" title="Restart">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>  
                    </div>
                    <!-- This is the div where the visualizations will be rendered -->
                    <div id="vis-div" class="">
                        <div class="skeleton skeleton-chart" role="status" aria-label="Loading visualization"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- This is the data table that will be rendered below the visualizations -->
    <div class="row  justify-content-center align-items-center pb-3">
        <div class="col">
            <div class="card">
                <div class="card-body overflow-scroll">
                    <h4 class="card-title" id="table-title"></h4>
                    <p class="table-caption">The same data shown in the chart above, as a table.</p>
                    <div id="data-table" class="text-center">
                        <div class="text-start" role="status" aria-label="Loading data table">
                            <div class="skeleton skeleton-line w-40"></div>
                            <div class="skeleton skeleton-line w-80"></div>
                            <div class="skeleton skeleton-line w-60"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- This is the row that contains the about this data section -->
    <div class="row justify-content-center align-items-center pb-2">
        <div class="col-md h-100">
            <div class="card h-100 overflow-y-scroll">
                <div class="card-body h-100">
                    <div id="about-data" class="h-100">
                        <div class="data-spinner-div" role="status" aria-label="Loading details">
                            <div class="skeleton skeleton-line w-40"></div>
                            <div class="skeleton skeleton-line w-80"></div>
                            <div class="skeleton skeleton-line w-60"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
    (async function() {
        try{
            province = "{{province}}";
            // fetch first: it populates the menu config (visuals) from the DB before we read it
            await fetchRegionData(province);
            currentVisual = visuals["default-visuals"][province];
            createMenu(province);
            masterLoop();
        } catch(error) {
            document.addEventListener('DOMContentLoaded', async function () {
            province = "{{province}}";
            await fetchRegionData(province);
            currentVisual = visuals["default-visuals"][province];
            createMenu(province);
            masterLoop();
            });
        }
    })();
    </script>
</div>

<!-- Update the browser title with an oob swap via HTMx -->
<title hx-swap-oob="true">CANASK | {{ province.replace("-", " ").title() }}</title>