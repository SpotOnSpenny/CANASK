<div id="reset-password-div" class="d-flex justify-content-center align-items-center w-100 vh-100">
    <div class="card shadow-sm" style="width: 30rem; max-width: 92vw;">
        <div class="card-body p-4">
            <h3 class="card-title mb-1 text-center">Reset Your Password</h3>
            <p class="text-center text-muted mb-4">Choose a new password for your account.</p>
            <div id="form-alerts"></div>

            <form id="reset-password-form"
                  hx-post="/v1/reset-password"
                  hx-target="#partial-inclusions"
                  hx-swap="innerHTML swap:1s settle:1s"
                  hx-disabled-elt="find button[type='submit']">

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address</label>
                    <p class="form-control-plaintext">{{ email }}</p>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label fw-semibold">New Password</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           placeholder="Choose a new password"
                           minlength="12"
                           maxlength="72"
                           required>
                    <div class="form-text">12-72 characters with an uppercase letter, a lowercase letter, a number, and a special character.</div>
                </div>

                <div class="mb-4">
                    <label for="confirm_password" class="form-label fw-semibold">Confirm Password</label>
                    <input type="password"
                           id="confirm_password"
                           name="confirm_password"
                           class="form-control"
                           placeholder="Confirm your new password"
                           minlength="12"
                           maxlength="72"
                           required>
                </div>

                <button type="submit" class="btn btn-primary w-100">Reset Password</button>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    document.getElementById('reset-password-form').addEventListener('htmx:configRequest', function(event) {
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirm_password').value;
        const alerts = document.getElementById('flashed-messages-container');

        if (password !== confirmPassword) {
            event.preventDefault();
            alerts.innerHTML =`
            <div class="position-fixed top-0 start-50 translate-middle-x pt-3" style="z-index: 1050; width: 50%;">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    The passwords provided did not match.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
            `;
            return;
        }
    });
})();
</script>
