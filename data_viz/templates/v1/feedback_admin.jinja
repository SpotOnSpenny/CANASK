{# Site-admin Feedback page (data_viz/feedback_admin.py). The filter buttons re-request this same
   partial (HX-Request) with ?status= and swap the whole div, so the active button and the list
   always come from the server together. #}
{# data-hx-flash-errors opts the page into main.js's htmx:responseError handler: htmx won't swap a
   4xx/5xx body, so without it a failed card action (another admin already deleted it -> 404) would
   be a silent no-op. #}
<div id="feedback-admin-div" class="container py-4" data-hx-flash-errors>
    <div class="feedback-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h5 class="mb-0">Feedback</h5>
            <p class="text-body-secondary small mb-0">
                Submissions from the public feedback form. Stored here even when the notification
                email fails.
            </p>
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="Filter feedback by status">
            {% for key, label in [("open", "Open"), ("addressed", "Addressed"), ("all", "All")] %}
            <button type="button"
                class="btn {{ 'btn-primary' if status == key else 'btn-outline-primary' }}"
                hx-get="/v1/admin/feedback?status={{ key }}"
                hx-target="#feedback-admin-div" hx-swap="outerHTML"
                hx-push-url="/v1/admin/feedback?status={{ key }}"
                {% if status == key %}aria-current="true"{% endif %}>
                {{ label }}
            </button>
            {% endfor %}
        </div>
    </div>
    <div id="feedback-list">
        {% if items|length >= max_listed %}
        <p class="text-body-secondary small">Showing the newest {{ max_listed }} submissions.</p>
        {% endif %}
        {% if not items %}
        <p class="text-body-secondary text-center py-4 mb-0">
            {% if status == "open" %}No open feedback.{% elif status == "addressed" %}No addressed feedback yet.{% else %}No feedback yet.{% endif %}
        </p>
        {% endif %}
        {% for s in items %}
            {% with expanded = false %}{% include "v1/partials/feedback_card.jinja" %}{% endwith %}
        {% endfor %}
    </div>
</div>
