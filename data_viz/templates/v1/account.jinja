{# "My account": one card, one tab per option (auth.ACCOUNT_TABS). Each tab is its own URL; a tab
   link swaps this whole container and pushes the URL, so only the open tab is ever rendered. #}
<div id="account-div" class="container py-4">
    <div class="row justify-content-center">
        {# Wider on mid-size windows so the four tabs fit on one line without scrolling. #}
        <div class="col-12 col-xl-10 col-xxl-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-3">My account</h5>
                    <ul class="nav nav-tabs card-header-tabs" aria-label="Account options">
                        {% for key, label in tabs %}
                        {% set url = "/v1/account" if key == "info" else "/v1/account/" ~ key %}
                        <li class="nav-item">
                            <a class="nav-link{% if key == active_tab %} active{% endif %}" href="{{ url }}"
                               hx-get="{{ url }}" hx-target="#account-div" hx-swap="outerHTML" hx-push-url="true"
                               {% if key == active_tab %}aria-current="page"{% endif %}>{{ label }}</a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="card-body">
                    {% if active_tab == "starting-charts" %}
                        {% include "v1/partials/starting_charts_section.jinja" %}
                    {% elif active_tab == "password" %}
                        {% include "v1/partials/account_password.jinja" %}
                    {% elif active_tab == "sign-ins" %}
                        {% include "v1/partials/account_sign_ins.jinja" %}
                    {% else %}
                        {% include "v1/partials/account_info.jinja" %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
