<div id="invite-user-div" class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Invite a New User</h5>
                </div>
                <div class="card-body">
                    <p class="form-intro">Enter the person's email, then choose the group(s) and role they should
                        have. Each role grants a different level of access, and is assigned on a per-group basis.</p>
                    <div id="form-alerts"></div>
                    <form id="invite-form"
                          hx-post="/v1/invite-user"
                          hx-target="#content-div"
                          hx-swap="innerHTML swap:1s settle:1s"
                          hx-disabled-elt="find button[type='submit']">

                        <div class="mb-4">
                            <label for="email" class="form-label fw-semibold">Email Address</label>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control"
                                   maxlength="254"
                                   placeholder="Enter the email address to invite"
                                   required>
                        </div>

                        <hr class="my-3">

                        <div class="accordion" id="groupAccordion">
                            {% for group_name, roles in invitable_roles.items() %}
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading_{{ loop.index }}">
                                        <button class="accordion-button collapsed" 
                                                type="button" 
                                                data-bs-toggle="collapse"
                                                data-bs-target="#collapse_{{ loop.index }}"
                                                aria-expanded="false"
                                                aria-controls="collapse_{{ loop.index }}">
                                            {{ group_name }}
                                            <!-- Show a badge if a role has been selected for this group -->
                                            <span class="badge bg-primary ms-2 d-none" id="badge_{{ loop.index }}"></span>
                                        </button>
                                    </h2>
                                    <div id="collapse_{{ loop.index }}" 
                                        class="accordion-collapse collapse"
                                        aria-labelledby="heading_{{ loop.index }}">
                                        <div class="accordion-body">
                                            {% for role in roles %}
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                        type="radio"
                                                        name="group_assignment_{{ group_name }}"
                                                        value="{{ group_name }}__{{ role }}"
                                                        id="role_{{ group_name }}_{{ role }}">
                                                    <label class="form-check-label"
                                                        for="role_{{ group_name }}_{{ role }}">
                                                        {{ role.replace("_", " ").title() }}
                                                    </label>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        {# Shown only while a Site Admin role is selected -- a site-admin invite
                           spends the shared site admin key (verified server-side). #}
                        <div id="site-admin-credentials" class="d-none">
                            <hr class="my-3">
                            <p class="form-text mb-2">Granting site admin access requires extra confirmation.</p>
                            <div class="mb-3">
                                <label class="form-label" for="iv-own-password">Your account password</label>
                                <input class="form-control" type="password" name="own_password"
                                       id="iv-own-password" autocomplete="current-password">
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="iv-site-admin-key">Site admin key</label>
                                <input class="form-control" type="password" name="site_admin_key"
                                       id="iv-site-admin-key" autocomplete="off">
                                <div class="form-text">The shared site admin key guards every site admin membership change.</div>
                            </div>
                        </div>

                        <hr class="my-3">

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-4">
                                Send Invite
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        const form = document.getElementById('invite-form');

        // Client side form validation
        form.addEventListener('htmx:configRequest', function(event) {
            const selectedRole = document.querySelector('#invite-form input[type="radio"]:checked');
            if (!selectedRole) {
                event.preventDefault();
                document.getElementById('form-alerts').innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show position-absolute w-50" role="alert">
                        Please select a role before sending the invite.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
            }
        });

        const radios = () => document.querySelectorAll('#invite-form input[type="radio"]');
        let lastChecked = {};

        function isSiteAdminRadio(radio) {
            return radio.value.includes('__Site Admin');
        }

        function enableAllRadios() {
            radios().forEach(r => {
                r.disabled = false;
                r.closest('.accordion-item').style.opacity = '1';
            });
        }

        function clearRadio(r) {
            r.disabled = true;
            r.checked = false;
            r.closest('.accordion-item').style.opacity = '0.5';
            const badge = r.closest('.accordion-item').querySelector('.badge');
            badge.textContent = '';
            badge.classList.add('d-none');
            lastChecked[r.name] = null;
        }

        function disableNonSiteAdminRadios() {
            radios().forEach(r => { if (!isSiteAdminRadio(r)) clearRadio(r); });
        }

        function disableSiteAdminRadios() {
            radios().forEach(r => { if (isSiteAdminRadio(r)) clearRadio(r); });
        }

        function anyNonSiteAdminSelected() {
            return Array.from(radios()).filter(r => r.checked).some(r => !isSiteAdminRadio(r));
        }

        function anySiteAdminSelected() {
            return Array.from(radios()).filter(r => r.checked).some(r => isSiteAdminRadio(r));
        }

        function syncSiteAdminCredentials() {
            const box = document.getElementById('site-admin-credentials');
            if (box) box.classList.toggle('d-none', !anySiteAdminSelected());
        }

        radios().forEach(radio => {
            radio.addEventListener('click', function() {
                const group_role = this.name;

                if (lastChecked[group_role] === this) {
                    // Same radio clicked again — uncheck it
                    this.checked = false;
                    lastChecked[group_role] = null;

                    // Clear badge
                    const accordionItem = this.closest('.accordion-item');
                    const badge = accordionItem.querySelector('.badge');
                    badge.textContent = '';
                    badge.classList.add('d-none');

                    // Re-enable everything if nothing conflicts anymore
                    if (!anyNonSiteAdminSelected() && !anySiteAdminSelected()) {
                        enableAllRadios();
                    } else if (!anySiteAdminSelected()) {
                        enableAllRadios();
                        disableSiteAdminRadios();
                    } else if (!anyNonSiteAdminSelected()) {
                        enableAllRadios();
                        disableNonSiteAdminRadios();
                    }

                } else {
                    // New radio selected — update tracking and badge
                    lastChecked[group_role] = this;
                    const accordionItem = this.closest('.accordion-item');
                    const badge = accordionItem.querySelector('.badge');
                    const [group, role] = this.value.split('__');
                    badge.textContent = role;
                    badge.classList.remove('d-none');

                    // Enforce mutual exclusivity
                    if (isSiteAdminRadio(this)) {
                        disableNonSiteAdminRadios();
                    } else {
                        disableSiteAdminRadios();
                    }
                }
                syncSiteAdminCredentials();
            });
        });

        document.querySelectorAll('#invite-form .form-check-label').forEach(label => {
            label.addEventListener('mousedown', function(event) {
                if (event.detail > 1) {
                    event.preventDefault();
                }
            });
        });
    })();
</script>