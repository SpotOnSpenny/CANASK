<!-- Generated by claude, will edit and stylize later -->
<div id="invite-user-div">
    <div id="form-alerts"></div>

    <h2>Invite User</h2>

    <form id="invite-form"
          hx-post="/v1/invite-user"
          hx-target="#invite-user-div"
          hx-swap="innerHTML">

        <div>
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required>
        </div>

        {% for option in invite_options %}
            <h4>{{ option.group_name }}</h4>
            {% for role in option.roles %}
                <div>
                    <input type="radio"
                           name="selected_role"
                           value="{{ role }}"
                           data-group-id="{{ option.group.id if option.group else '' }}"
                           id="role_{{ option.group.id if option.group else 'site' }}_{{ role }}">
                    <label for="role_{{ option.group.id if option.group else 'site' }}_{{ role }}">
                        {{ role.replace("_", " ").title() }}
                    </label>
                </div>
            {% endfor %}
        {% endfor %}

        <input type="hidden" name="group_id" id="selected_group_id" value="">
        <input type="hidden" name="role" id="selected_role_value" value="">

        <button type="submit">Send Invite</button>
    </form>
</div>

<script>
    document.querySelectorAll('input[name="selected_role"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.getElementById('selected_group_id').value = this.dataset.groupId;
            document.getElementById('selected_role_value').value = this.value;
        });
    });

    document.getElementById('invite-form').addEventListener('htmx:configRequest', function(event) {
        const selectedRole = document.querySelector('input[name="selected_role"]:checked');
        if (!selectedRole) {
            event.preventDefault();
            document.getElementById('form-alerts').innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    Please select a role before sending the invite.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
        }
    });
</script>