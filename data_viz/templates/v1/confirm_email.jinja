{# The page a "confirm your new email" link opens (auth.account_confirm_email). Opening it changes
   nothing -- mail scanners open links -- so the change is made by the button's POST. No sign-in
   is needed: the link is the proof. #}
<div id="confirm-email-div" class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="card-title mb-3">Confirm your new email address</h3>
                    <p>This will change the email on the CANASK account
                        <strong>{{ account_user.username }}</strong> to:</p>
                    <p class="fs-5 fw-semibold">{{ new_email }}</p>
                    <p class="text-body-secondary">You'll use the new address to sign in and to
                        reset your password. Other devices will be signed out.</p>
                    <form hx-post="/v1/account/confirm-email/{{ token }}" hx-swap="none"
                          hx-disabled-elt="find button[type='submit']">
                        <button type="submit" class="btn btn-primary">Confirm new email</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
