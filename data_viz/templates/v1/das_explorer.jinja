<div class="container h-100 mobile-height-adjust py-2">
    <!-- Header: page title, dataset switcher, and the Visualize toggle -->
    <div class="row justify-content-center align-items-center py-2 mb-2 g-2">
        <div class="col">
            <div class="card">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                    <nav class="vis-breadcrumb mb-0" aria-label="Breadcrumb">
                        <span class="crumb crumb-current">DAS Explorer</span>
                    </nav>
                    <div class="d-flex btn-group" id="das-dataset-toggle" role="group" aria-label="Dataset">
                        <!-- Dataset radio buttons are generated by dasExplorer.js -->
                    </div>
                    <button type="button" class="btn btn-secondary" id="das-visualize-toggle"
                        data-bs-toggle="collapse" data-bs-target="#das-visualize-card"
                        aria-expanded="false" aria-controls="das-visualize-card">
                        <i class="bi bi-bar-chart-line"></i> Visualize
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Visualize: pivot-style chart builder (collapsed until opened) -->
    <div class="collapse" id="das-visualize-card">
        <div class="row justify-content-center align-items-center pb-2">
            <div class="col">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-end gap-2 das-pivot-controls">
                            <!-- Rows / Columns / Measure / Chart type selects are generated by dasExplorer.js -->
                        </div>
                        <p class="table-caption mt-2 mb-1">
                            Charts respect whatever header filters are active on the table. If you
                            chart by drug or drug class, a sample containing several drugs counts
                            once under each of them. Before charting average quantity, filter or
                            split by Units, since an average across different units (%, g, mg&hellip;)
                            isn't meaningful. Map charts show the measure by place; add a month or
                            year split to get a time slider. Any place the map can't draw appears
                            in a note below the chart.
                        </p>
                        <p class="text-warning small d-none" id="das-pivot-truncated">
                            Showing only the largest categories. Refine with filters to see the rest.
                        </p>
                        <p class="text-warning small d-none" id="das-pivot-unmapped"></p>
                        <div id="das-pivot-chart"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- The explorer table -->
    <div class="row justify-content-center align-items-center pb-2">
        <div class="col">
            <div class="card">
                <div class="card-body das-table-card">
                    <h4 class="card-title" id="das-table-title"></h4>
                    <p class="table-caption">
                        Each row is one result. Click a column header to sort, use the boxes
                        beneath the headers to filter, and drag headers to rearrange columns.
                        Text filters understand <code>AND</code>, <code>OR</code>, <code>NOT</code>,
                        parentheses, and quoted phrases, e.g.
                        <code>(fentanyl AND cocaine) OR lsd</code>. Dropdown filters let you pick
                        several values at once. In the Drugs Identified filter, <code>*</code>
                        means any drug not named elsewhere in your expression, so
                        <code>cocaine NOT *</code> finds samples where cocaine was the only drug
                        identified.
                    </p>
                    <div id="das-table"></div>
                </div>
            </div>
        </div>
    </div>
    <!-- About this data -->
    <div class="row justify-content-center align-items-center pb-2">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <div id="about-data">
                        <h4 class="card-title text-center">About these Data</h4>
                        <hr />
                        {% if das_source %}
                        {% if das_source.last_updated_str or das_source.data_until_str %}
                        <h5 class="text-center">
                            {%- if das_source.last_updated_str %}This data set was last updated on {{ das_source.last_updated_str }}{% if das_source.data_until_str %} and contains data up until {{ das_source.data_until_str }}{% endif %}.
                            {%- else %}This data set contains data up until {{ das_source.data_until_str }}.
                            {%- endif %}
                        </h5>
                        {% endif %}
                        <p>{{ das_source.about }}</p>
                        <div class="text-center pb-3">
                            <a target="_blank" rel="noopener" href="{{ das_source.link }}" role="button"
                                class="btn btn-primary">{{ das_source.name }}</a>
                        </div>
                        {% else %}
                        <p class="mb-0">Source details are unavailable until the DAS data has been ingested.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
    (function() {
        function boot() {
            initDasExplorer({{ das_config | tojson }});
        }
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", boot);
        } else {
            boot();
        }
    })();
    </script>
</div>
