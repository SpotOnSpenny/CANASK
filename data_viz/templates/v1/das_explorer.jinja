<div class="container h-100 mobile-height-adjust py-2">
    <!-- Header: page title, dataset switcher, and the Visualize toggle -->
    <div class="row justify-content-center align-items-center py-2 mb-2 g-2">
        <div class="col">
            <div class="card">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                    <nav class="vis-breadcrumb mb-0" aria-label="Breadcrumb">
                        <span class="crumb crumb-current">DAS Explorer</span>
                    </nav>
                    <div class="d-flex btn-group" id="das-dataset-toggle" role="group" aria-label="Dataset">
                        <!-- Dataset radio buttons are generated by dasExplorer.js -->
                    </div>
                    <button type="button" class="btn btn-secondary" id="das-visualize-toggle"
                        data-bs-toggle="collapse" data-bs-target="#das-visualize-card"
                        aria-expanded="false" aria-controls="das-visualize-card">
                        <i class="bi bi-bar-chart-line"></i> Visualize
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Visualize: pivot-style chart builder (collapsed until opened) -->
    <div class="collapse" id="das-visualize-card">
        <div class="row justify-content-center align-items-center pb-2">
            <div class="col">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-end gap-2 das-pivot-controls">
                            <!-- Rows / Columns / Measure / Chart type selects are generated by dasExplorer.js -->
                        </div>
                        <p class="table-caption mt-2 mb-1">
                            Charts respect the table's active header filters. With a drug or class
                            dimension, a sample containing several drugs is counted once for each.
                            When charting average quantity, filter or split by Units first &mdash;
                            an average across different units (%, g, mg&hellip;) isn't meaningful.
                            Map charts show the measure by place; split by a month or year dimension
                            to get a time slider, and any place the map can't draw is listed below
                            the chart rather than silently dropped.
                        </p>
                        <p class="text-warning small d-none" id="das-pivot-truncated">
                            Showing only the largest categories &mdash; refine with filters to see the rest.
                        </p>
                        <p class="text-warning small d-none" id="das-pivot-unmapped"></p>
                        <div id="das-pivot-chart"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- The explorer table -->
    <div class="row justify-content-center align-items-center pb-2">
        <div class="col">
            <div class="card">
                <div class="card-body das-table-card">
                    <h4 class="card-title" id="das-table-title"></h4>
                    <p class="table-caption">
                        One row per result. Sort by clicking a column header, filter with the boxes
                        beneath the headers, and drag headers to rearrange columns. Text filters
                        understand <code>AND</code>, <code>OR</code>, <code>NOT</code>, parentheses,
                        and quoted phrases &mdash; e.g. <code>(fentanyl AND cocaine) OR lsd</code> &mdash;
                        and dropdown filters allow picking several values at once. In the Drugs
                        Identified filter, <code>*</code> stands for any drug not named elsewhere in
                        your expression &mdash; e.g. <code>cocaine NOT *</code> finds samples where
                        only cocaine was identified.
                    </p>
                    <div id="das-table"></div>
                </div>
            </div>
        </div>
    </div>
    <!-- About this data -->
    <div class="row justify-content-center align-items-center pb-2">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <div id="about-data">
                        <h4 class="card-title">About This Data</h4>
                        {% if das_source %}
                        <p>{{ das_source.about }}</p>
                        <p class="mb-0">
                            Source: <a href="{{ das_source.link }}" target="_blank" rel="noopener">{{ das_source.name }}</a>
                            {% if das_source.last_updated_str %} &middot; Retrieved {{ das_source.last_updated_str }}{% endif %}
                            {% if das_source.data_until_str %} &middot; Data until {{ das_source.data_until_str }}{% endif %}
                        </p>
                        {% else %}
                        <p class="mb-0">Source details are unavailable until the DAS data has been ingested.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
    (function() {
        function boot() {
            initDasExplorer({{ das_config | tojson }});
        }
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", boot);
        } else {
            boot();
        }
    })();
    </script>
</div>
