<div id="forgot-password-div" class="d-flex justify-content-center align-items-center w-100 vh-100">
    <div class="card shadow-sm" style="width: 24rem;">
        <div class="card-body p-4">
            <h3 class="card-title mb-3 text-center">Forgot Password</h3>
            <p class="text-center">Enter the email address on your account and we'll send you a link to reset your password.</p>
            <form
                id="forgot-password-form"
                hx-post="/v1/forgot-password"
                hx-target="#partial-inclusions"
                hx-swap="innerHTML swap:1s settle:1s"
                hx-disabled-elt="find button[type='submit']"
                data-recaptcha-action="forgot_password"
                class="needs-validation"
                novalidate
            >
                <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input
                    type="email"
                    name="email"
                    id="email"
                    class="form-control"
                    maxlength="254"
                    required
                    autofocus
                >
                <div class="invalid-feedback">
                    Please enter a valid email address.
                </div>
                </div>

                <button type="submit" class="btn btn-primary w-100">Send reset link</button>
            </form>

            <div class="text-center mt-3">
                <a href="/v1/login" hx-get="/v1/login"
                   hx-target="#partial-inclusions" hx-swap="innerHTML swap:1s settle:1s"
                   hx-push-url="/v1/login" class="small auth-card-link">Back to log in</a>
            </div>
        </div>
    </div>
</div>
