<div id="home-orient">
    <header class="home-hero">
        <h1 class="home-title">Canadian Alliance for Substance Knowledge</h1>
        <p class="home-lede">Current, sourced statistics on Canada's drug-toxicity crisis, from a variety of sources.
            CANASK gathers these into one place so you can read the trend, not chase the report.</p>
    </header>

    <section class="home-section">
        <h2 class="home-section-title">Explore by province</h2>
        <div class="region-grid">
            {% if 'british-columbia' in accessible_provinces %}
            <a class="region-tile htmx-element" href="/v1/province/british-columbia"
                hx-get="/v1/province/british-columbia" hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s"
                hx-push-url="/v1/province/british-columbia">
                <i class="bi bi-geo-alt region-tile-ic" aria-hidden="true"></i>
                <span class="region-tile-name">British Columbia</span>
                <i class="bi bi-arrow-right region-tile-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}
            {% if 'alberta' in accessible_provinces %}
            <a class="region-tile htmx-element" href="/v1/province/alberta" hx-get="/v1/province/alberta"
                hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/alberta">
                <i class="bi bi-geo-alt region-tile-ic" aria-hidden="true"></i>
                <span class="region-tile-name">Alberta</span>
                <i class="bi bi-arrow-right region-tile-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}
            {% if 'saskatchewan' in accessible_provinces %}
            <a class="region-tile htmx-element" href="/v1/province/saskatchewan" hx-get="/v1/province/saskatchewan"
                hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/saskatchewan">
                <i class="bi bi-geo-alt region-tile-ic" aria-hidden="true"></i>
                <span class="region-tile-name">Saskatchewan</span>
                <i class="bi bi-arrow-right region-tile-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}
            {% if 'manitoba' in accessible_provinces %}
            <a class="region-tile htmx-element" href="/v1/province/manitoba" hx-get="/v1/province/manitoba"
                hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/manitoba">
                <i class="bi bi-geo-alt region-tile-ic" aria-hidden="true"></i>
                <span class="region-tile-name">Manitoba</span>
                <i class="bi bi-arrow-right region-tile-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}
            {% if 'ontario' in accessible_provinces %}
            <a class="region-tile htmx-element" href="/v1/province/ontario" hx-get="/v1/province/ontario"
                hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/ontario">
                <i class="bi bi-geo-alt region-tile-ic" aria-hidden="true"></i>
                <span class="region-tile-name">Ontario</span>
                <i class="bi bi-arrow-right region-tile-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}
            {% if 'new-brunswick' in accessible_provinces %}
            <a class="region-tile htmx-element" href="/v1/province/new-brunswick" hx-get="/v1/province/new-brunswick"
                hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/new-brunswick">
                <i class="bi bi-geo-alt region-tile-ic" aria-hidden="true"></i>
                <span class="region-tile-name">New Brunswick</span>
                <i class="bi bi-arrow-right region-tile-arrow" aria-hidden="true"></i>
            </a>
            {% endif %}
            {% if not accessible_provinces %}
            <p class="text-muted mb-0">No province data is available to you yet.
                {% if not current_user.is_authenticated %}<a href="/v1/login">Sign in</a> to view
                data shared with your groups.{% endif %}</p>
            {% endif %}
        </div>
    </section>

    {% if current_user.is_authenticated %}
    <section class="home-section">
        <h2 class="home-section-title">National</h2>
        <a class="region-tile region-tile-wide htmx-element" href="/v1/national/drug-checking"
            hx-get="/v1/national/drug-checking" hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s"
            hx-push-url="/v1/national/drug-checking">
            <i class="bi bi-clipboard-data region-tile-ic" aria-hidden="true"></i>
            <span class="region-tile-name">Drug Checking</span>
            <i class="bi bi-arrow-right region-tile-arrow" aria-hidden="true"></i>
        </a>
    </section>
    {% endif %}

    <section class="home-about">
        <h2 class="home-about-title">
            <i class="bi bi-shield-check" aria-hidden="true"></i> About the data
        </h2>
        <p class="home-about-text">Every visualization shows when it was last updated and links back to its original
            source including coroners services, public-health agencies, and community drug-checking programs across
            Canada.</p>
        <ul class="home-facts">
            <li>
                <i class="bi bi-patch-check" aria-hidden="true"></i>
                <span><strong>Dated &amp; sourced</strong>Every chart cites its source and when it was last
                    updated.</span>
            </li>
            <li>
                <i class="bi bi-sliders" aria-hidden="true"></i>
                <span><strong>Counts, rates &amp; percentages</strong>Switch how each figure is shown.</span>
            </li>
            <li>
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                <span><strong>Drill in</strong>From a province to a health authority to a single year.</span>
            </li>
        </ul>
    </section>

    <footer class="home-partners">
        <span class="home-partners-label">In partnership with</span>
        <div class="home-partners-logos">
            <a class="home-partner-link" href="https://www.ccsa.ca/" target="_blank" rel="noopener noreferrer"
                title="Canadian Centre on Substance Use and Addiction">
                <img src="/static/assets/images/ccsa_logo.png" class="home-partner-logo"
                    alt="Canadian Centre on Substance Use and Addiction" />
            </a>
            <a class="home-partner-link" href="https://cumming.ucalgary.ca/centres/centre-health-informatics"
                target="_blank" rel="noopener noreferrer"
                title="University of Calgary Centre for Health Informatics">
                <img src="/static/assets/images/CHI.jpeg" class="home-partner-logo"
                    alt="University of Calgary Centre for Health Informatics" />
            </a>
        </div>
    </footer>
</div>
