        <button class="nav-toggle" type="button" aria-label="Toggle navigation menu" aria-expanded="false">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <h1 class="mobile-title">
            <a href="/" hx-get="/" hx-trigger="click" hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s"
                hx-push-url="/">CANASK</a>
        </h1>
    </div>
    <div id="mobile-nav-link-container">
