            <a href="/v1/login">Sign in</a> to view data shared with your groups.</p>
        {% else %}
        {% if current_user.is_authenticated %}
        <h2 class="nav-title">National Trends</h2>
        <a href="/toxicity-deaths" hx-get="/toxicity-deaths" hx-trigger="click" hx-target="#content-div"
            hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/toxicity-deaths" class="mobile-nav-link htmx-element">
            Total Toxicity Deaths
        </a>
        {% endif %}
        <h2 class="nav-title">Provincial Trends</h2>
        {% if 'british-columbia' in accessible_provinces %}
        <a href="/v1/province/british-columbia" hx-get="/v1/province/british-columbia" hx-trigger="click"
            hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s"
            hx-push-url="/v1/province/british-columbia" class="mobile-nav-link htmx-element">
            British Columbia
        </a>
        {% endif %}
        {% if 'alberta' in accessible_provinces %}
        <a href="/v1/province/alberta" hx-get="/v1/province/alberta" hx-trigger="click" hx-target="#content-div"
            hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/alberta" class="mobile-nav-link htmx-element">
            Alberta
        </a>
        {% endif %}
        {% if 'saskatchewan' in accessible_provinces %}
        <a href="/v1/province/saskatchewan" hx-get="/v1/province/saskatchewan" hx-trigger="click"
            hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/saskatchewan"
            class="mobile-nav-link htmx-element">
            Saskatchewan
        </a>
        {% endif %}
        {% if 'manitoba' in accessible_provinces %}
        <a href="/v1/province/manitoba" hx-get="/v1/province/manitoba" hx-trigger="click" hx-target="#content-div"
            hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/manitoba" class="mobile-nav-link htmx-element">
            Manitoba
        </a>
        {% endif %}
        {% if current_user.is_authenticated %}
        <a href="/province/ontario" hx-get="/province/ontario" hx-trigger="click" hx-target="#content-div"
            hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/province/ontario" class="mobile-nav-link htmx-element">
            Ontario
        </a>
        {% endif %}
        {% if 'new-brunswick' in accessible_provinces %}
        <a href="/v1/province/new-brunswick" hx-get="/v1/province/new-brunswick" hx-trigger="click"
            hx-target="#content-div" hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/province/new-brunswick"
            class="mobile-nav-link htmx-element">
            New Brunswick
        </a>
        {% endif %}
        {% if nav_perms.manage_users %}
        <h2 class="nav-title">Account</h2>
        <a href="/v1/user-management" hx-get="/v1/user-management" hx-trigger="click" hx-target="#content-div"
            hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/user-management" class="mobile-nav-link htmx-element">
            User management
        </a>
        {% if nav_perms.manage_data %}
        <a href="/v1/group-management" hx-get="/v1/group-management" hx-trigger="click" hx-target="#content-div"
            hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/group-management" class="mobile-nav-link htmx-element">
            Group management
        </a>
        <a href="/v1/data-ownership" hx-get="/v1/data-ownership" hx-trigger="click" hx-target="#content-div"
            hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/v1/data-ownership" class="mobile-nav-link htmx-element">
            Data ownership
        </a>
        {% endif %}
        {% endif %}
        {% if not current_user.is_authenticated %}
        <h2 class="nav-title">Account</h2>
        <a href="/v1/login" class="mobile-nav-link htmx-element">Sign in</a>
        {% endif %}
        {% endif %}
    </div>
</div>
