<div class="p-5 w-100 h-100 d-flex justify-content-center align-items-center">
    <div class="card">
        <div class="card-body text-center">
            <div class="not-found-title-container">
                <img src="/static/assets/images/unlink.svg" class="img-fluid rounded-top logos" alt="429 Too Many Requests" />
                <h4 class="card-title">Too Many Requests</h4>
            </div>
            <p class="card-text">You're making requests a little too quickly. Please wait a moment and try again.
                If you believe this is a mistake, refresh the page shortly or contact us.
            </p>
            <a hx-get="/" hx-trigger="click" hx-target="#content-div"
                hx-swap="innerHTML swap:1s settle:1s" hx-push-url="/" class="btn btn-primary">Return to Home
            </a>
        </div>
    </div>
</div>
